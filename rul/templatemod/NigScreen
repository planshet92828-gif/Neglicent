package rul.templatemod;

import net.minecraft.client.gui.DrawContext;
import net.minecraft.client.gui.screen.Screen;
import net.minecraft.text.Text;

public class NigScreen extends Screen {
    public NigScreen() {
        super(Text.literal("NIG"));
    }

    @Override
    public void render(DrawContext context, int mouseX, int mouseY, float delta) {
        // Заливаем фон чёрным
        context.fill(0, 0, this.width, this.height, 0xFF000000);
        // Рисуем текст NIG по центру
        context.drawCenteredTextWithShadow(this.textRenderer, "NIG", this.width / 2, this.height / 2, 0xFFFFFF);
    }

    @Override
    public boolean shouldPause() {
        return false;
    }
}